_id) as duplicate_order_count,\\n    sum(revenue_usd) as total_revenue_usd,\\n    count_if(customer_name is null) as missing_customer_names,\\n    count_if(product_name is null) as missing_product_names\\nfrom fct_orders_refactored --limit 1 --output json --log-format json --no-use-colors\", 'log_cache_events': 'False', 'fail_fast': 'False', 'log_format': 'json', 'version_check': 'True', 'partial_parse': 'True', 'profiles_dir': '/Users/fivetran/Documents/Fivetran/dbt_demo', 'cache_selected_only': 'False', 'warn_error': 'None', 'static_parser': 'True', 'log_path': '/Users/fivetran/Documents/Fivetran/dbt_demo/logs'}", "name": "MainReportArgs", "pid": 26875, "thread": "MainThread", "ts": "2026-06-08T12:17:12.428320Z"}}
