{"data": {"conn_name": "sql_operation.dbt_demo.inline_query", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "80b40a3a142dae197f0c6f4abfe27dddaba12d5f9c06b4132c1921ae1d879482", "node_finished_at": "", "node_name": "inline_query", "node_path": "sql/inline_query", "node_relation": {"alias": "inline_query", "database": "JUSTIN_SMALL", "relation_name": "", "schema": "dbt_demo"}, "node_started_at": "2026-06-08T12:17:15.275157", "node_status": "executing", "resource_type": "sql_operation", "unique_id": "sql_operation.dbt_demo.inline_query"}, "sql": "with orders as (\n    select\n        order_id,\n        order_date,\n        status,\n        customer_id,\n        product_id,\n        quantity\n    from JUSTIN_SMALL.dbt_demo_staging.stg_orders\n),\ncustomers as (\n    select\n        customer_id,\n        full_name,\n        email,\n        country\n    from JUSTIN_SMALL.dbt_demo_staging.stg_customers\n),\nproducts as (\n    select\n        product_id,\n        product_name,\n        category,\n        price_usd\n    from JUSTIN_SMALL.dbt_demo_staging.stg_products\n),\nfct_orders_refactored as (\n    select\n        o.order_id,\n        o.order_date,\n        o.status,\n        o.customer_id,\n        c.full_name as customer_name,\n        c.email as customer_email,\n        c.country as customer_country,\n        o.product_id,\n        p.product_name,\n        p.category as product_category,\n        p.price_usd,\n        o.quantity,\n        o.quantity * p.price_usd as revenue_usd\n    from orders o\n    left join customers c on o.customer_id = c.customer_id\n    left join products p on o.product_id = p.product_id\n)\nselect\n    count(*) as row_count,\n    count(distinct order_id) as distinct_order_count,\n    count(*) - count(distinct order_id) as duplicate_order_count,\n    sum(revenue_usd) as total_revenue_usd,\n    count_if(customer_name is null) as missing_customer_names,\n    count_if(product_name is null) as missing_product_names\nfrom fct_orders_refactored\n  \n  limit 1\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.19\", \"profile_name\": \"dbt_demo\", \"target_name\": \"dev\", \"node_id\": \"sql_operation.dbt_demo.inline_query\"} */"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "54c5567e-923a-40ce-8008-7c56b845359c", "level": "debug", "msg": "On sql_operation.dbt_demo.inline_query: with orders as (\n    select\n        order_id,\n        order_date,\n        status,\n        customer_id,\n        product_id,\n        quantity\n    from JUSTIN_SMALL.dbt_demo_staging.stg_orders\n),\ncustomers as (\n    select\n        customer_id,\n        full_name,\n        email,\n        country\n    from JUSTIN_SMALL.dbt_demo_staging.stg_customers\n),\nproducts as (\n    select\n        product_id,\n        product_name,\n        category,\n        price_usd\n    from JUSTIN_SMALL.dbt_demo_staging.stg_products\n),\nfct_orders_refactored as (\n    select\n        o.order_id,\n        o.order_date,\n        o.status,\n        o.customer_id,\n        c.full_name as customer_name,\n        c.email as customer_email,\n        c.country as customer_country,\n        o.product_id,\n        p.product_name,\n        p.category as product_category,\n        p.price_usd,\n        o.quantity,\n        o.quantity * p.price_usd as revenue_usd\n    from orders o\n    left join customers c on o.customer_id = c.customer_id\n    left join products p on o.product_id = p.product_id\n)\nselect\n    count(*) as row_count,\n    count(distinct order_id) as distinct_order_count,\n    count(*) - count(distinct order_id) as duplicate_order_count,\n    sum(revenue_usd) as total_revenue_usd,\n    count_if(customer_name is null) as missing_customer_names,\n    count_if(product_name is null) as missing_product_names\nfrom fct_orders_refactored\n  \n  limit 1\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.19\", \"profile_name\": \"dbt_demo\", \"target_name\": \"dev\", \"node_id\": \"sql_operation.dbt_demo.inline_query\"} */", "name": "SQLQuery", "pid": 26875, "thread": "Thread-3", "ts": "2026-06-08T12:17:15.285732Z"}}
