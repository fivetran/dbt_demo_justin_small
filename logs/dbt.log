{"data": {"conn_name": "model.dbt_demo.fct_orders", "node_info": {"materialized": "table", "meta": {}, "node_checksum": "093d01c111a5ee50ff422dc0f436fc022e558adaf3fa5a7170d95d816693fa40", "node_finished_at": "", "node_name": "fct_orders", "node_path": "marts/fct_orders.sql", "node_relation": {"alias": "fct_orders", "database": "JUSTIN_SMALL", "relation_name": "JUSTIN_SMALL.dbt_demo_marts.fct_orders", "schema": "dbt_demo_marts"}, "node_started_at": "2026-06-08T12:16:58.298203", "node_status": "executing", "resource_type": "model", "unique_id": "model.dbt_demo.fct_orders"}, "sql": "with orders as (\n    select\n        order_id,\n        order_date,\n        status,\n        customer_id,\n        product_id,\n        quantity\n    from JUSTIN_SMALL.dbt_demo_staging.stg_orders\n),\n\ncustomers as (\n    select\n        customer_id,\n        full_name,\n        email,\n        country\n    from JUSTIN_SMALL.dbt_demo_staging.stg_customers\n),\n\nproducts as (\n    select\n        product_id,\n        product_name,\n        category,\n        price_usd\n    from JUSTIN_SMALL.dbt_demo_staging.stg_products\n),\n\njoined as (\n    select\n        o.order_id,\n        o.order_date,\n        o.status,\n\n        -- Customer fields\n        o.customer_id,\n        c.full_name               as customer_name,\n        c.email                   as customer_email,\n        c.country                 as customer_country,\n\n        -- Product fields\n        o.product_id,\n        p.product_name,\n        p.category                as product_category,\n        p.price_usd,\n\n        -- Metrics\n        o.quantity,\n        o.quantity * p.price_usd  as revenue_usd\n    from orders o\n    left join customers c on o.customer_id = c.customer_id\n    left join products  p on o.product_id  = p.product_id\n)\n\nselect * from joined\n  \n  limit 5\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.19\", \"profile_name\": \"dbt_demo\", \"target_name\": \"dev\", \"node_id\": \"model.dbt_demo.fct_orders\"} */"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "384293d6-dbaa-4aaa-aa4b-046a652af1cc", "level": "debug", "msg": "On model.dbt_demo.fct_orders: with orders as (\n    select\n        order_id,\n        order_date,\n        status,\n        customer_id,\n        product_id,\n        quantity\n    from JUSTIN_SMALL.dbt_demo_staging.stg_orders\n),\n\ncustomers as (\n    select\n        customer_id,\n        full_name,\n        email,\n        country\n    from JUSTIN_SMALL.dbt_demo_staging.stg_customers\n),\n\nproducts as (\n    select\n        product_id,\n        product_name,\n        category,\n        price_usd\n    from JUSTIN_SMALL.dbt_demo_staging.stg_products\n),\n\njoined as (\n    select\n        o.order_id,\n        o.order_date,\n        o.status,\n\n        -- Customer fields\n        o.customer_id,\n        c.full_name               as customer_name,\n        c.email                   as customer_email,\n        c.country                 as customer_country,\n\n        -- Product fields\n        o.product_id,\n        p.product_name,\n        p.category                as product_category,\n        p.price_usd,\n\n        -- Metrics\n        o.quantity,\n        o.quantity * p.price_usd  as revenue_usd\n    from orders o\n    left join customers c on o.customer_id = c.customer_id\n    left join products  p on o.product_id  = p.product_id\n)\n\nselect * from joined\n  \n  limit 5\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.19\", \"profile_name\": \"dbt_demo\", \"target_name\": \"dev\", \"node_id\": \"model.dbt_demo.fct_orders\"} */", "name": "SQLQuery", "pid": 26869, "thread": "Thread-3", "ts": "2026-06-08T12:16:59.127012Z"}}
