{"data": {"compiled": "\n\nwith orders as (\n    select\n        order_id,\n        order_date,\n        status,\n        customer_id,\n        customer_name,\n        customer_email,\n        customer_country,\n        product_id,\n        product_name,\n        product_category,\n        price_usd,\n        quantity,\n        revenue_usd\n    from JUSTIN_SMALL.dbt_demo_marts.fct_orders\n),\n\ncanonical_rows as (\n    select\n        order_date as partition_date,\n        (floor(cast(order_id as number(38, 0)) / 10000) * 10000)::number(38, 0) as key_range_start,\n        ((floor(cast(order_id as number(38, 0)) / 10000) * 10000) + 9999)::number(38, 0) as key_range_end,\n        order_id,\n        concat_ws(\n            '|',\n            'order_id=' || coalesce(to_varchar(order_id), '__dbt_null__'),\n            'order_date=' || coalesce(to_varchar(order_date, 'YYYY-MM-DD'), '__dbt_null__'),\n            'status=' || coalesce(status, '__dbt_null__'),\n            'customer_id=' || coalesce(to_varchar(customer_id), '__dbt_null__'),\n            'customer_name=' || coalesce(customer_name, '__dbt_null__'),\n            'customer_email=' || coalesce(customer_email, '__dbt_null__'),\n            'customer_country=' || coalesce(customer_country, '__dbt_null__'),\n            'product_id=' || coalesce(to_varchar(product_id), '__dbt_null__'),\n            'product_name=' || coalesce(product_name, '__dbt_null__'),\n            'product_category=' || coalesce(product_category, '__dbt_null__'),\n            'price_usd=' || coalesce(to_varchar(cast(price_usd as number(38, 2))), '__dbt_null__'),\n            'quantity=' || coalesce(to_varchar(quantity), '__dbt_null__'),\n            'revenue_usd=' || coalesce(to_varchar(cast(revenue_usd as number(38, 2))), '__dbt_null__')\n        ) as canonical_row_payload\n    from orders\n),\n\naggregated as (\n    select\n        partition_date,\n        key_range_start,\n        key_range_end,\n        count(*) as row_count,\n        sum(quantity) as quantity_sum,\n        sum(cast(revenue_usd as number(38, 2))) as revenue_usd_sum,\n        min(order_id) as min_order_id,\n        max(order_id) as max_order_id,\n        hash_agg(canonical_row_payload) as row_hash_agg,\n        sha2(\n            listagg(canonical_row_payload, '\\n') within group (order by order_id),\n            256\n        ) as checksum_sha256\n    from canonical_rows\n    group by 1, 2, 3\n)\n\nselect\n    partition_date,\n    key_range_start,\n    key_range_end,\n    row_count,\n    quantity_sum,\n    revenue_usd_sum,\n    min_order_id,\n    max_order_id,\n    row_hash_agg,\n    checksum_sha256,\n    current_timestamp() as checksum_generated_at\nfrom aggregated", "is_inline": false, "node_name": "fct_orders_snowflake_daily_checksums", "output_format": "text", "quiet": false, "unique_id": "model.dbt_demo.fct_orders_snowflake_daily_checksums"}, "info": {"category": "", "code": "Q042", "extra": {}, "invocation_id": "cd565a04-8d30-4310-82a3-7245d15cfdd0", "level": "info", "msg": "Compiled node 'fct_orders_snowflake_daily_checksums' is:\n\n\nwith orders as (\n    select\n        order_id,\n        order_date,\n        status,\n        customer_id,\n        customer_name,\n        customer_email,\n        customer_country,\n        product_id,\n        product_name,\n        product_category,\n        price_usd,\n        quantity,\n        revenue_usd\n    from JUSTIN_SMALL.dbt_demo_marts.fct_orders\n),\n\ncanonical_rows as (\n    select\n        order_date as partition_date,\n        (floor(cast(order_id as number(38, 0)) / 10000) * 10000)::number(38, 0) as key_range_start,\n        ((floor(cast(order_id as number(38, 0)) / 10000) * 10000) + 9999)::number(38, 0) as key_range_end,\n        order_id,\n        concat_ws(\n            '|',\n            'order_id=' || coalesce(to_varchar(order_id), '__dbt_null__'),\n            'order_date=' || coalesce(to_varchar(order_date, 'YYYY-MM-DD'), '__dbt_null__'),\n            'status=' || coalesce(status, '__dbt_null__'),\n            'customer_id=' || coalesce(to_varchar(customer_id), '__dbt_null__'),\n            'customer_name=' || coalesce(customer_name, '__dbt_null__'),\n            'customer_email=' || coalesce(customer_email, '__dbt_null__'),\n            'customer_country=' || coalesce(customer_country, '__dbt_null__'),\n            'product_id=' || coalesce(to_varchar(product_id), '__dbt_null__'),\n            'product_name=' || coalesce(product_name, '__dbt_null__'),\n            'product_category=' || coalesce(product_category, '__dbt_null__'),\n            'price_usd=' || coalesce(to_varchar(cast(price_usd as number(38, 2))), '__dbt_null__'),\n            'quantity=' || coalesce(to_varchar(quantity), '__dbt_null__'),\n            'revenue_usd=' || coalesce(to_varchar(cast(revenue_usd as number(38, 2))), '__dbt_null__')\n        ) as canonical_row_payload\n    from orders\n),\n\naggregated as (\n    select\n        partition_date,\n        key_range_start,\n        key_range_end,\n        count(*) as row_count,\n        sum(quantity) as quantity_sum,\n        sum(cast(revenue_usd as number(38, 2))) as revenue_usd_sum,\n        min(order_id) as min_order_id,\n        max(order_id) as max_order_id,\n        hash_agg(canonical_row_payload) as row_hash_agg,\n        sha2(\n            listagg(canonical_row_payload, '\\n') within group (order by order_id),\n            256\n        ) as checksum_sha256\n    from canonical_rows\n    group by 1, 2, 3\n)\n\nselect\n    partition_date,\n    key_range_start,\n    key_range_end,\n    row_count,\n    quantity_sum,\n    revenue_usd_sum,\n    min_order_id,\n    max_order_id,\n    row_hash_agg,\n    checksum_sha256,\n    current_timestamp() as checksum_generated_at\nfrom aggregated", "name": "CompiledNode", "pid": 67928, "thread": "MainThread", "ts": "2026-06-15T23:02:42.099073Z"}}
