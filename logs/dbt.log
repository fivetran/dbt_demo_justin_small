{"data": {"args": {"cache_selected_only": "False", "debug": "False", "empty": "None", "fail_fast": "False", "indirect_selection": "eager", "introspect": "True", "invocation_command": "dbt show --inline with orders as (\n    select\n        order_id,\n        order_date,\n        status,\n        customer_id,\n        product_id,\n        quantity\n    from {{ ref('stg_orders') }}\n),\ncustomers as (\n    select\n        customer_id,\n        full_name,\n        email,\n        country\n    from {{ ref('stg_customers') }}\n),\nproducts as (\n    select\n        product_id,\n        product_name,\n        category,\n        price_usd\n    from {{ ref('stg_products') }}\n),\nfct_orders_refactored as (\n    select\n        o.order_id,\n        o.order_date,\n        o.status,\n        o.customer_id,\n        c.full_name as customer_name,\n        c.email as customer_email,\n        c.country as customer_country,\n        o.product_id,\n        p.product_name,\n        p.category as product_category,\n        p.price_usd,\n        o.quantity,\n        o.quantity * p.price_usd as revenue_usd\n    from orders o\n    left join customers c on o.customer_id = c.customer_id\n    left join products p on o.product_id = p.product_id\n)\nselect\n    count(*) as row_count,\n    count(distinct order_id) as distinct_order_count,\n    count(*) - count(distinct order_id) as duplicate_order_count,\n    sum(revenue_usd) as total_revenue_usd,\n    count_if(customer_name is null) as missing_customer_names,\n    count_if(product_name is null) as missing_product_names\nfrom fct_orders_refactored --limit 1 --output json --log-format json --no-use-colors", "log_cache_events": "False", "log_format": "json", "log_path": "/Users/fivetran/Documents/Fivetran/dbt_demo/logs", "no_print": "None", "partial_parse": "True", "printer_width": "80", "profiles_dir": "/Users/fivetran/Documents/Fivetran/dbt_demo", "quiet": "False", "send_anonymous_usage_stats": "True", "static_parser": "True", "target_path": "