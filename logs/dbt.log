{"data": {"conn_name": "model.dbt_demo.top_product_reviews", "node_info": {"materialized": "table", "meta": {}, "node_checksum": "2e87d4f2b2655f9fde255ab9d6b6516f19b69384691de3847eef5994aebd7457", "node_finished_at": "", "node_name": "top_product_reviews", "node_path": "marts/top_product_reviews.sql", "node_relation": {"alias": "top_product_reviews", "database": "JUSTIN_SMALL", "relation_name": "JUSTIN_SMALL.dbt_demo_marts.top_product_reviews", "schema": "dbt_demo_marts"}, "node_started_at": "2026-06-11T15:17:16.841695", "node_status": "executing", "resource_type": "model", "unique_id": "model.dbt_demo.top_product_reviews"}, "sql": "create or replace transient table JUSTIN_SMALL.dbt_demo_marts.top_product_reviews\n    \n    \n    \n    as (with products as (\n    select * from JUSTIN_SMALL.dbt_demo_marts.dim_products\n),\n\nreviews as (\n    select * from JUSTIN_SMALL.dbt_demo_staging.stg_reviews\n),\n\nranked_reviews as (\n    select\n        r.review_id,\n        r.customer_id,\n        r.product_id,\n        r.order_id,\n        r.rating,\n        r.review_date,\n        row_number() over (\n            partition by r.product_id\n            order by r.rating desc, r.review_date desc, r.review_id desc\n        ) as product_review_rank\n    from reviews r\n),\n\nfinal as (\n    select\n        p.product_id,\n        p.product_name,\n        p.category,\n        rr.review_id,\n        rr.customer_id,\n        rr.order_id,\n        rr.rating,\n        rr.review_date,\n        rr.product_review_rank\n    from ranked_reviews rr\n    inner join products p using (product_id)\n    where rr.product_review_rank <= 3\n)\n\nselect * from final\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.19\", \"profile_name\": \"dbt_demo\", \"target_name\": \"dev\", \"node_id\": \"model.dbt_demo.top_product_reviews\"} */;"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "e7380d66-a5d3-4b7f-81dc-40249eec8647", "level": "debug", "msg": "On model.dbt_demo.top_product_reviews: create or replace transient table JUSTIN_SMALL.dbt_demo_marts.top_product_reviews\n    \n    \n    \n    as (with products as (\n    select * from JUSTIN_SMALL.dbt_demo_marts.dim_products\n),\n\nreviews as (\n    select * from JUSTIN_SMALL.dbt_demo_staging.stg_reviews\n),\n\nranked_reviews as (\n    select\n        r.review_id,\n        r.customer_id,\n        r.product_id,\n        r.order_id,\n        r.rating,\n        r.review_date,\n        row_number() over (\n            partition by r.product_id\n            order by r.rating desc, r.review_date desc, r.review_id desc\n        ) as product_review_rank\n    from reviews r\n),\n\nfinal as (\n    select\n        p.product_id,\n        p.product_name,\n        p.category,\n        rr.review_id,\n        rr.customer_id,\n        rr.order_id,\n        rr.rating,\n        rr.review_date,\n        rr.product_review_rank\n    from ranked_reviews rr\n    inner join products p using (product_id)\n    where rr.product_review_rank <= 3\n)\n\nselect * from final\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.19\", \"profile_name\": \"dbt_demo\", \"target_name\": \"dev\", \"node_id\": \"model.dbt_demo.top_product_reviews\"} */;", "name": "SQLQuery", "pid": 74015, "thread": "Thread-6", "ts": "2026-06-11T15:17:17.923888Z"}}
