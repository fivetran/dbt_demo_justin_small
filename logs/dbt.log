),

final as (
    select
        p.product_id,
        p.product_name,
        p.category,
        p.price_usd,
        p.is_active,
        coalesce(s.total_units_sold, 0)   as total_units_sold,
        coalesce(s.total_revenue_usd, 0)  as total_revenue_usd,
        coalesce(s.unique_customers, 0)   as unique_customers
    from products p
    left join sales_stats s using (product_id)
)

