    end while;

    let rs resultset := (
        select
            f.value['OBJECT_NAME']::string as fqn,
            f.value['DEFINITION']::string as view_definition,
            f.value['ERROR']::string as error
        from table(flatten(input => :results)) f
        order by 1
    );

    return table(rs);
end;$$
