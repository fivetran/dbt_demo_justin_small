{"data": {"conn_name": "sql_operation.dbt_demo.inline_query", "node_info": {"materialized": "view", "meta": {}, "node_checksum": "c64a9a9ac1fbd8cc2732193228ca8665cb0411d389332fd7c4c3ed8dbd14b6ef", "node_finished_at": "", "node_name": "inline_query", "node_path": "sql/inline_query", "node_relation": {"alias": "inline_query", "database": "JUSTIN_SMALL", "relation_name": "", "schema": "dbt_demo"}, "node_started_at": "2026-06-08T12:15:29.662902", "node_status": "executing", "resource_type": "sql_operation", "unique_id": "sql_operation.dbt_demo.inline_query"}, "sql": "with orders as (\n    select * from JUSTIN_SMALL.dbt_demo_staging.stg_orders\n),\ncustomers as (\n    select * from JUSTIN_SMALL.dbt_demo_staging.stg_customers\n),\nproducts as (\n    select * from JUSTIN_SMALL.dbt_demo_staging.stg_products\n)\nselect\n    (select count(*) from orders) as order_rows,\n    (select count(distinct order_id) from orders) as distinct_orders,\n    (select count(*) from customers) as customer_rows,\n    (select count(distinct customer_id) from customers) as distinct_customers,\n    (select count(*) from products) as product_rows,\n    (select count(distinct product_id) from products) as distinct_products,\n    (select count(*) from orders o left join customers c on o.customer_id = c.customer_id where c.customer_id is null) as orders_missing_customer,\n    (select count(*) from orders o left join products p on o.product_id = p.product_id where p.product_id is null) as orders_missing_product\n  \n  limit 1\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.19\", \"profile_name\": \"dbt_demo\", \"target_name\": \"dev\", \"node_id\": \"sql_operation.dbt_demo.inline_query\"} */"}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "bc4bb6c1-addf-4474-b151-2dba2034fea2", "level": "debug", "msg": "On sql_operation.dbt_demo.inline_query: with orders as (\n    select * from JUSTIN_SMALL.dbt_demo_staging.stg_orders\n),\ncustomers as (\n    select * from JUSTIN_SMALL.dbt_demo_staging.stg_customers\n),\nproducts as (\n    select * from JUSTIN_SMALL.dbt_demo_staging.stg_products\n)\nselect\n    (select count(*) from orders) as order_rows,\n    (select count(distinct order_id) from orders) as distinct_orders,\n    (select count(*) from customers) as customer_rows,\n    (select count(distinct customer_id) from customers) as distinct_customers,\n    (select count(*) from products) as product_rows,\n    (select count(distinct product_id) from products) as distinct_products,\n    (select count(*) from orders o left join customers c on o.customer_id = c.customer_id where c.customer_id is null) as orders_missing_customer,\n    (select count(*) from orders o left join products p on o.product_id = p.product_id where p.product_id is null) as orders_missing_product\n  \n  limit 1\n/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.19\", \"profile_name\": \"dbt_demo\", \"target_name\": \"dev\", \"node_id\": \"sql_operation.dbt_demo.inline_query\"} */", "name": "SQLQuery", "pid": 26767, "thread": "Thread-3", "ts": "2026-06-08T12:15:29.682776Z"}}
