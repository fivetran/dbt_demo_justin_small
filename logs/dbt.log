{"data": {"compiled": "with orders as (\n    select\n        order_id,\n        order_date,\n        status,\n        customer_id,\n        product_id,\n        quantity\n    from JUSTIN_SMALL.dbt_demo_staging.stg_orders\n),\n\ncustomers as (\n    select\n        customer_id,\n        full_name,\n        email,\n        country\n    from JUSTIN_SMALL.dbt_demo_staging.stg_customers\n),\n\nproducts as (\n    select\n        product_id,\n        product_name,\n        category,\n        price_usd\n    from JUSTIN_SMALL.dbt_demo_staging.stg_products\n),\n\njoined as (\n    select\n        o.order_id,\n        o.order_date,\n        o.status,\n\n        -- Customer fields\n        o.customer_id,\n        c.full_name               as customer_name,\n        c.email                   as customer_email,\n        c.country                 as customer_country,\n\n        -- Product fields\n        o.product_id,\n        p.product_name,\n        p.category                as product_category,\n        p.price_usd,\n\n        -- Metrics\n        o.quantity,\n        o.quantity * p.price_usd  as revenue_usd\n    from orders o\n    left join customers c on o.customer_id = c.customer_id\n    left join products  p on o.product_id  = p.product_id\n)\n\nselect * from joined", "is_inline": false, "node_name": "fct_orders", "output_format": "text", "quiet": false, "unique_id": "model.dbt_demo.fct_orders"}, "info": {"category": "", "code": "Q042", "extra": {}, "invocation_id": "8d5ba4b3-e9b6-4f3d-8f7c-fdd20913cc43", "level": "info", "msg": "Compiled node 'fct_orders' is:\nwith orders as (\n    select\n        order_id,\n        order_date,\n        status,\n        customer_id,\n        product_id,\n        quantity\n    from JUSTIN_SMALL.dbt_demo_staging.stg_orders\n),\n\ncustomers as (\n    select\n        customer_id,\n        full_name,\n        email,\n        country\n    from JUSTIN_SMALL.dbt_demo_staging.stg_customers\n),\n\nproducts as (\n    select\n        product_id,\n        product_name,\n        category,\n        price_usd\n    from JUSTIN_SMALL.dbt_demo_staging.stg_products\n),\n\njoined as (\n    select\n        o.order_id,\n        o.order_date,\n        o.status,\n\n        -- Customer fields\n        o.customer_id,\n        c.full_name               as customer_name,\n        c.email                   as customer_email,\n        c.country                 as customer_country,\n\n        -- Product fields\n        o.product_id,\n        p.product_name,\n        p.category                as product_category,\n        p.price_usd,\n\n        -- Metrics\n        o.quantity,\n        o.quantity * p.price_usd  as revenue_usd\n    from orders o\n    left join customers c on o.customer_id = c.customer_id\n    left join products  p on o.product_id  = p.product_id\n)\n\nselect * from joined", "name": "CompiledNode", "pid": 26799, "thread": "MainThread", "ts": "2026-06-08T12:16:04.461607Z"}}
